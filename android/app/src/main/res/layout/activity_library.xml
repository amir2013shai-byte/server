<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/dndBg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:background="?attr/dndTopbar"
        android:elevation="3dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            android:tint="?attr/dndTopbarText"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Назад" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:text="Офлайн-библиотека"
            android:textColor="?attr/dndTopbarText"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnSync"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="10dp"
            android:src="@drawable/ic_download"
            android:tint="?attr/dndTopbarText"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Скачать раздел" />

        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="10dp"
            android:src="@drawable/ic_more"
            android:tint="?attr/dndTopbarText"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Ещё" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <EditText
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:hint="Поиск по сохранённым страницам"
            android:textColorHint="?attr/dndTextDim"
            android:textColor="?attr/dndText"
            android:textSize="14sp"
            android:singleLine="true"
            android:inputType="text" />

        <TextView
            android:id="@+id/tvStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingTop="10dp"
            android:paddingBottom="2dp"
            android:textColor="?attr/dndTextDim"
            android:textSize="12sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="?attr/dndDivider"
        android:dividerHeight="1dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:clipToPadding="false"
        android:scrollbarStyle="outsideOverlay" />

    <LinearLayout
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_library"
            android:tint="?attr/dndTextDim"
            android:alpha="0.6" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:gravity="center"
            android:text="Пока ничего не сохранено.\nОткройте раздел и нажмите «Скачать раздел», чтобы читать без интернета."
            android:textColor="?attr/dndTextDim"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnEmptySync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Скачать раздел"
            android:textColor="?attr/dndTopbarText"
            android:backgroundTint="?attr/dndBrand" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/syncHost"
        android:layout_width="1dp"
        android:layout_height="1dp" />
</LinearLayout>
